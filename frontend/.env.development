# Local development against the Firebase Auth emulator (docker compose). Not secrets:
# "demo-" project ids tell Firebase there is no real project, and the emulator accepts any key.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tenex.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tenex
VITE_AUTH_EMULATOR_URL=http://localhost:9099
